# Server port
PORT=3001

# CORS allowed origin (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Database connection string (PostgreSQL - Supabase)
# DATABASE_URL usa PgBouncer (transaction pooler, port 6543)
# DIRECT_URL es conexión directa (necesario para prisma migrate)
# DATABASE_URL="postgresql://postgres.project:password@aws-1-us-west-2.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.project:password@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

DATABASE_URL="postgresql://localhost:5432/egg-demo"
DIRECT_URL="postgresql://localhost:5432/egg-demo"

# Groq API key
GROQ_API_KEY=gsk_tu_key_aqui

# Email SMTP (opcional - en dev usa console.log)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=noreply@example.com
# EMAIL_PASS=your-password

# Web URL for email links
WEB_URL=http://localhost:5173
